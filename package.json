{
  "name": "hewstudio",
  "version": "0.1.0",
  "description": "HEWStudio — Locked-down kiosk workspace for children's computers",
  "main": "dist/main/main.js",
  "private": true,
  "author": {
    "name": "Halisy",
    "email": "infomail@codlogics.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "dev": "tsc -p tsconfig.json -w",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux deb",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.hewstudio",
    "productName": "HEWStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "executableName": "hewstudio",
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "HewStudio",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "bin/inputhook",
          "to": "bin/inputhook"
        },
        {
          "from": "bin/watchdog",
          "to": "bin/watchdog"
        }
      ]
    },
    "asar": true
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}